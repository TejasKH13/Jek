
pipeline {
    agent {
        label 'master'
    }

    stages {
        stage('Build') {
            steps {
                script {
                    try {
                        sh '''
                            exit 1
                        '''
                    } catch (Exception e) {
                        echo "Exception is handled: ${e.message}"
                        currentBuild.result = 'SUCCESS'
                        currentStage.result = 'FAILURE'
                        
                    }
                }
            }
        }

        stage('Test') {
            steps {
                echo "2nd stage is executed"
            }
        }
    }
}
