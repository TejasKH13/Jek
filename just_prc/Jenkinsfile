pipeline {
    agent {
        label 'master'
    }
    stages {
        stage('Build') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            sh '''
                                pwd
                                exit 1
                            '''

            }
            
        }

    }
    stage('Test') {
        steps {
            echo "2nd stage is executed"
        }
    }

 }
}