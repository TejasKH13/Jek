pipeline {
    agent {
        label 'master'
    }
    stages {
        stage('Build') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            sh '''
                                sleep 10
                                exit 1
                            '''

            }
            
        }

    }
    stage('Test') {
        steps {
            sh '2nd stage is exected'
        }
    }

 }
}